rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminOrVendedor() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor'];
    }

    function isTaller() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'taller';
    }

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdminOrVendedor();
    }

    // Clients collection
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();

      match /structures/{structureId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isAdminOrVendedor() || isTaller();
      }

      match /addresses/{addressId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isAdminOrVendedor();
      }
    }

    // Leads collection
    match /leads/{leadId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Lead activities
    match /leadActivities/{activityId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Quotations
    match /quotations/{quotationId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Quotation items
    match /quotationItems/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Order items
    match /orderItems/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Order payments
    match /orderPayments/{paymentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Company settings
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrVendedor();
    }

    // Production orders
    match /productionOrders/{orderId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Production tasks
    match /productionTasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Production photos
    match /productionPhotos/{photoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Inventory items
    match /inventoryItems/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Inventory locations
    match /inventoryLocations/{locationId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Inventory movements
    match /inventoryMovements/{movementId} {
      allow read: if request.auth != null;
      allow create: if isAdminOrVendedor() || isTaller();
      allow update, delete: if isAdminOrVendedor();
    }

    // Inventory stock by location
    match /inventoryStock/{stockId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Purchase requests
    match /purchaseRequests/{requestId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Purchase request items
    match /purchaseRequestItems/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Purchase orders
    match /purchaseOrders/{orderId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Purchase order items
    match /purchaseOrderItems/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Purchase payments
    match /purchasePayments/{paymentId} {
      allow read: if request.auth != null;
      allow create: if isAdminOrVendedor();
      allow update, delete: if isAdminOrVendedor();
    }

    // Maintenance assets
    match /maintenanceAssets/{assetId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }

    // Maintenance records
    match /maintenanceRecords/{recordId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor() || isTaller();
    }

    // Maintenance notifications
    match /maintenanceNotifications/{notifId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminOrVendedor();
    }
  }
}
