rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admins can read all profiles
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Clients collection — any authenticated user can read; only admin/vendedor can write
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor'];

      // Structures subcollection — same rules as parent
      match /structures/{structureId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor', 'tecnico'];
      }

      // Addresses subcollection
      match /addresses/{addressId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor'];
      }
    }

    // Leads collection — any authenticated user can read; admin/vendedor can write
    match /leads/{leadId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor'];
    }

    // Lead activities — any authenticated user can read/write
    match /leadActivities/{activityId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor'];
    }

    // Quotations — any authenticated user can read; admin/vendedor can write
    match /quotations/{quotationId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor'];
    }

    // Quotation items
    match /quotationItems/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor'];
    }
  }
}
