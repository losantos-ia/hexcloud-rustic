rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Company logo — any authenticated user can read;
    // admin or vendedor can write (upload/delete)
    match /settings/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Expense receipts — authenticated users can upload PDF/images up to 10 MB
    match /expenses/receipts/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
